  payoutNo      String          @unique
  uploadId      String?
  upload        IncentiveUpload? @relation(fields: [uploadId], references: [id])
  consultantId  String
  consultant    User            @relation("IncentiveConsultant", fields: [consultantId], references: [id])
  periodMonth   Int
  periodYear    Int
  amount        Float
  status        String          @default("CALCULATED") // CALCULATED, APPROVED, PAID
  approvedById  String?
  approvedBy    User?           @relation("IncentiveApprover", fields: [approvedById], references: [id])
  paidAt        DateTime?
  paymentRef    String?
  createdAt     DateTime        @default(now())
}

model DayClose {
  id               String   @id @default(cuid())
  closeNo          String   @unique
  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id])
  closeDate        DateTime
  billsTotal       Float    @default(0)
  collectionsTotal Float    @default(0)
  cashCollections  Float    @default(0)
  cardCollections  Float    @default(0)
  upiCollections   Float    @default(0)
  bankCollections  Float    @default(0)
  depositsTotal    Float    @default(0)
  pettyTotal       Float    @default(0)
  refundsTotal     Float    @default(0)
  systemCash       Float    @default(0)
  physicalCash     Float    @default(0)
  variance         Float    @default(0)
  dtrId            String?
  gstOutput        Float    @default(0)
  status           String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, LOCKED
  notes            String?
  closedById       String
  closedBy         User     @relation("DayCloseCloser", fields: [closedById], references: [id])
  approvedById     String?
  approvedBy       User?    @relation("DayCloseApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([branchId, closeDate])
}

model FactoryIndent {
  id            String              @id @default(cuid())
  indentNo      String              @unique
  branchId      String
  branch        Branch              @relation(fields: [branchId], references: [id])
  status        String              @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED, PARTIAL
  notes         String?
  itemsJson     String?
  items         FactoryIndentItem[]
  purchaseOrders PurchaseOrder[]
  grns          GRN[]
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())
}

model FactoryIndentItem {
  id        String        @id @default(cuid())
  indentId  String
  indent    FactoryIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  fulfilled Int           @default(0)
}

model AssetPurchaseOrder {
  id          String         @id @default(cuid())
  apoNo       String         @unique
  vendorId    String?
  vendor      Vendor?        @relation(fields: [vendorId], references: [id])
  branchId    String?
  status      String         @default("PENDING_AUTH")
  totalAmount Float          @default(0)
  notes       String?
  items       AssetPOItem[]
  createdById String
  createdAt   DateTime       @default(now())
}

model AssetPOItem {
  id          String             @id @default(cuid())
  apoId       String
  apo         AssetPurchaseOrder @relation(fields: [apoId], references: [id], onDelete: Cascade)
  description String
  quantity    Int                @default(1)
  unitCost    Float              @default(0)
  totalAmount Float              @default(0)
}

// ─── General Ledger (Debit / Credit) ─────────────────────────────────────────

model ChartOfAccount {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  accountType String        // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  normalSide  String        // DEBIT, CREDIT
  branchId    String?
  isActive    Boolean       @default(true)
  journalLines JournalLine[]
  createdAt   DateTime      @default(now())
}

model JournalEntry {
  id          String        @id @default(cuid())
  entryNo     String        @unique
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  entryDate   DateTime      @default(now())
  sourceType  String        // PAYMENT, BILL, REFUND, ADVANCE, PETTY_CASH
  sourceId    String
  description String?
  status      String        @default("POSTED")
  createdById String?
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
}

model JournalLine {
  id             String         @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  debit          Float          @default(0)
  credit         Float          @default(0)
  memo           String?
}

// Login sessions — table created/managed by express-mysql-session (src/lib/sessionStore.js).
// Declared here so `prisma db push` does not drop it as an "unknown" table.
model ExpressSession {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText

  @@map("express_sessions")
}
