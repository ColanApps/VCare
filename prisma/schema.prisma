generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── RBAC & Organization ───────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  level       Int      @default(0)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Zone {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Branch {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  type         String   @default("HAIR") // HAIR, SKIN, PRP, AESTHETICS, MIXED
  address      String?
  cityId       String?
  city         City?    @relation(fields: [cityId], references: [id])
  zoneId       String?
  zone         Zone?    @relation(fields: [zoneId], references: [id])
  phone        String?
  email        String?
  isActive     Boolean  @default(true)
  users        User[]
  customers    Customer[]
  appointments Appointment[]
  bills        Bill[]
  stocks       Stock[]
  indents      Indent[]
  targets      LocationTarget[]
  tickets      Ticket[]
  pettyCash    PettyCash[]
  iouRequests  IOURequest[]
  stockMovements StockMovement[]
  clinicalConsumptions ClinicalConsumption[]
  procedures       Procedure[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  advanceReceipts AdvanceReceipt[]
  customerVisits  CustomerVisit[]
  cashDeposits    CashDeposit[]
  stockOutwards   StockOutward[]
  physicalAudits  PhysicalStockAudit[]
  salesOrders     SalesOrder[]
  workOrders      WorkOrder[]
  biometricLogs   BiometricLog[]
  locationTargetDays LocationTargetDay[]
  ccLocationTargets  CCLocationTarget[]
  dtrRecords      DTRRecord[]
  dayCloses       DayClose[]
  journalEntries  JournalEntry[]
  manpowerReqs    ManpowerRequisition[]
  investments     Investment[]
  newJoinees      NewJoinee[]
  documents       DocumentStore[]
  factoryIndents  FactoryIndent[]
  purchaseOrders  PurchaseOrder[]
  grns            GRN[]
  assets          Asset[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrgNode {
  id           String    @id @default(cuid())
  title        String
  designation  String
  department   String?
  parentId     String?
  parent       OrgNode?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children     OrgNode[] @relation("OrgHierarchy")
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id])
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Designation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  gradeId   String?
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  users     User[]
  createdAt DateTime @default(now())
}

model Grade {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  level        Int           @default(1)
  designations Designation[]
  createdAt    DateTime      @default(now())
}

model User {
  id             String    @id @default(cuid())
  employeeId     String    @unique
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  designationId  String?
  designation    Designation? @relation(fields: [designationId], references: [id])
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  orgNode        OrgNode?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  lastLoginIp    String?
  sessions       UserSession[]
  auditLogs      AuditLog[]
  appointments   Appointment[] @relation("ConsultantAppointments")
  consultations  Consultation[]
  billsCreated   Bill[]    @relation("BillCreator")
  ticketsCreated Ticket[]  @relation("TicketCreator")
  ticketsAssigned Ticket[] @relation("TicketAssignee")
  indentsCreated Indent[]  @relation("IndentCreator")
  indentsApproved Indent[] @relation("IndentApprover")
  iouRequests    IOURequest[] @relation("IOURequester")
  iouApprovals   IOURequest[] @relation("IOUApprover")
  biometricLogs  BiometricLog[]
  dayClosesClosed DayClose[] @relation("DayCloseCloser")
  dayClosesApproved DayClose[] @relation("DayCloseApprover")
  incentivePayouts IncentivePayout[] @relation("IncentiveConsultant")
  incentivePayoutsApproved IncentivePayout[] @relation("IncentiveApprover")
  proceduresPerformed Procedure[] @relation("ProcedurePerformer")
  advanceApplications AdvanceApplication[] @relation("AdvanceApplier")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model IpWhitelist {
  id          String   @id @default(cuid())
  ipAddress   String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  module     String
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// ─── Geographical Masters ────────────────────────────────────────────────────

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  states    State[]
  createdAt DateTime @default(now())
}

model State {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  cities    City[]
  createdAt DateTime @default(now())
}

model City {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  areas     Area[]
  branches  Branch[]
  createdAt DateTime @default(now())
}

model Area {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
}

model Bank {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  accountNumber String?
  ifscCode      String?
  branchName    String?
  createdAt     DateTime @default(now())
}

model Company {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  gstin     String?
  address   String?
  createdAt DateTime @default(now())
}

// ─── Treatment Masters ─────────────────────────────────────────────────────────

model Therapist {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  specialty String?
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Treatment {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String   @default("HAIR") // HAIR, SKIN
  duration    Int      @default(60)
  basePrice   Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  procedures  Procedure[]
}

model Diagnosis {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String   @default("HAIR")
  description String?
  createdAt   DateTime @default(now())
}

model Surgeon {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  specialty String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Occupation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
}

model KnownBy {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
}

// ─── Targets ─────────────────────────────────────────────────────────────────

model LocationTarget {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  month     Int
  year      Int
  target    Float    @default(0)
  achieved  Float    @default(0)
  createdAt DateTime @default(now())
  @@unique([branchId, month, year])
}

model ConsultantTarget {
  id           String @id @default(cuid())
  consultantId String
  month        Int
  year         Int
  target       Float  @default(0)
  achieved     Float  @default(0)
  createdAt    DateTime @default(now())
}

// ─── Customer Module ─────────────────────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  uhid          String   @unique
  firstName     String
  lastName      String
  email         String?
  phone         String
  alternatePhone String?
  gender        String?
  dateOfBirth   DateTime?
  occupationId  String?
  knownById     String?
  address       String?
  cityId        String?
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  leadSource    String?
  category      String   @default("HAIR") // HAIR, SKIN
  customerType  String   @default("INDIVIDUAL") // INDIVIDUAL, CORPORATE
  companyName   String?
  gstin         String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, DISCONTINUED
  registeredAt  DateTime @default(now())
  appointments  Appointment[]
  consultations Consultation[]
  bills         Bill[]
  procedures    Procedure[]
  followUps     FollowUp[]
  photos        CustomerPhoto[]
  treatmentSlips TreatmentSlip[]
  trichoscanTests TrichoscanTest[]
  scheduleSteps SchedulePendingStep[]
  advanceReceipts AdvanceReceipt[]
  loanAccounts  LoanAccount[]
  visits        CustomerVisit[]
  treatmentFeedbacks TreatmentFeedback[]
  customerTests CustomerTest[]
  permanentRefunds PermanentRefund[]
  cashDeposits  CashDeposit[]
  salesOrders   SalesOrder[]
  refundComplaints RefundComplaint[]
  callAudits    CallAudit[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Consultation {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  consultantId String
  consultant   User     @relation(fields: [consultantId], references: [id])
  type         String   @default("INITIAL") // INITIAL, REGULAR, FOLLOW_UP
  chiefComplaint String?
  diagnosis    String?
  notes        String?
  recommendations String?
  status       String   @default("PENDING") // PENDING, COMPLETED
  consultedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  treatmentSlips TreatmentSlip[]
  trichoscanTests TrichoscanTest[]
  scheduleSteps SchedulePendingStep[]
}

model CustomerPhoto {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  type       String   // BEFORE, AFTER, TRICHOSCAN, PROCEDURE_PRE, PROCEDURE_POST
  filePath   String
  caption    String?
  takenAt    DateTime @default(now())
  createdAt  DateTime @default(now())
}

// ─── Appointments ──────────────────────────────────────────────────────────────

model Appointment {
  id             String   @id @default(cuid())
  appointmentNo  String   @unique
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  consultantId   String?
  consultant     User?    @relation("ConsultantAppointments", fields: [consultantId], references: [id])
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  treatmentId    String?
  type           String   @default("CONSULTATION") // CONSULTATION, TREATMENT, PROCEDURE, FOLLOW_UP
  category       String   @default("HAIR")
  scheduledAt    DateTime
  duration       Int      @default(30)
  status         String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  leadSource     String?
  campaign       String?
  notes          String?
  source         String   @default("WALK_IN") // WALK_IN, CALL_CENTER, ONLINE, REFERRAL
  reminderSent   Boolean  @default(false)
  procedures     Procedure[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Procedure {
  id           String   @id @default(cuid())
  procedureNo  String   @unique
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  treatmentId  String?
  treatment    Treatment? @relation(fields: [treatmentId], references: [id])
  appointmentId String?
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  performerId  String?
  performer    User?    @relation("ProcedurePerformer", fields: [performerId], references: [id])
  treatmentSlipId String?
  treatmentSlip TreatmentSlip? @relation(fields: [treatmentSlipId], references: [id])
  sessionNo    Int?
  customerVisitId String? @unique
  customerVisit CustomerVisit? @relation(fields: [customerVisitId], references: [id])
  scheduledAt  DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  status       String   @default("BOOKED") // BOOKED, IN_PROGRESS, COMPLETED, CANCELLED
  consentGiven Boolean  @default(false)
  consentFormPath String?
  consumptionApplied Boolean @default(false)
  notes        String?
  billId       String?  @unique
  bill         Bill?    @relation("ProcedureBill", fields: [billId], references: [id])
  pharmacyBillId String? @unique
  pharmacyBill Bill?    @relation("ProcedurePharmacyBill", fields: [pharmacyBillId], references: [id])
  createdAt    DateTime @default(now())
}

model SchedulePendingStep {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  step           String   // CONSULTATION, BEFORE_PHOTO, TRICHOSCAN, TREATMENT_SLIP, REGULAR_CONSULTATION, AFTER_PHOTO
  status         String   @default("PENDING") // PENDING, COMPLETED, SKIPPED
  completedAt    DateTime?
  completedById  String?
  notes          String?
  createdAt      DateTime @default(now())
  @@unique([customerId, consultationId, step])
}

model TreatmentSlip {
  id             String   @id @default(cuid())
  slipNo         String   @unique
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  treatments     String   // JSON array of planned treatments
  sessions       Int      @default(1)
  sessionCadence String   @default("WEEKLY") // WEEKLY, MONTHLY, CUSTOM
  cadenceDays    Int?
  nextSessionDueAt DateTime?
  lastSessionCompletedAt DateTime?
  notes          String?
  status         String   @default("ACTIVE")
  createdById    String
  procedures     Procedure[]
  createdAt      DateTime @default(now())
}

model TrichoscanTest {
  id             String   @id @default(cuid())
  testNo         String   @unique
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  hairDensity    Float?
  hairDiameter   Float?
  follicleCount  Int?
  scalpCondition String?
  findings       String?
  recommendations String?
  performedById  String
  testedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
}

model FollowUp {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  type         String   // PENDING_ADVANCE, SUPPLEMENTS, NOT_JOINED, TREATMENT, REGULAR
  status       String   @default("PENDING")
  scheduledAt  DateTime?
  completedAt  DateTime?
  feedback     String?
  nextFollowUp DateTime?
  assignedTo   String?
  createdAt    DateTime @default(now())
}

// ─── Billing ───────────────────────────────────────────────────────────────────

model Bill {
  id            String     @id @default(cuid())
  billNo        String     @unique
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id])
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id])
  createdById   String
  createdBy     User       @relation("BillCreator", fields: [createdById], references: [id])
  billDate      DateTime   @default(now())
  subtotal      Float      @default(0)
  discount      Float      @default(0)
  taxAmount     Float      @default(0)
  totalAmount   Float      @default(0)
  paidAmount    Float      @default(0)
  balanceAmount Float      @default(0)
  status        String     @default("DRAFT") // DRAFT, PENDING, PARTIAL, PAID, CANCELLED, REFUNDED
  billType      String     @default("SERVICE") // SERVICE, PHARMACY, PRODUCT
  paymentMode   String?
  items         BillItem[]
  payments      Payment[]
  creditNotes   CreditNote[]
  loanAccounts  LoanAccount[]
  source        String     @default("CENTER") // CENTER, ONLINE, B2B
  buyerGstin    String?
  poReference   String?
  grnId         String?    @unique
  grn           GRN?       @relation(fields: [grnId], references: [id])
  onlineOrderId String?    @unique
  maintenanceLogs BillMaintenanceLog[]
  linkedProcedure Procedure? @relation("ProcedureBill")
  pharmacyProcedure Procedure? @relation("ProcedurePharmacyBill")
  advanceApplications AdvanceApplication[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model BillItem {
  id          String  @id @default(cuid())
  billId      String
  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemType    String  // SERVICE, PRODUCT
  itemCode    String
  itemName    String
  quantity    Int     @default(1)
  unitPrice   Float
  discount    Float   @default(0)
  taxRate     Float   @default(18)
  taxAmount   Float   @default(0)
  totalAmount Float
}

model Payment {
  id            String   @id @default(cuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id])
  amount        Float
  paymentMode   String   // CASH, CARD, UPI, LOAN, ADVANCE
  referenceNo   String?
  paymentDate   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
}

model CreditNote {
  id          String   @id @default(cuid())
  creditNoteNo String  @unique
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id])
  amount      Float
  reason      String
  type        String   @default("REFUND") // REFUND, CREDIT_NOTE, CANCELLATION
  status      String   @default("ISSUED") // ISSUED, PROCESSED
  createdById String
  createdAt   DateTime @default(now())
}

// ─── Inventory & Purchase ──────────────────────────────────────────────────────

model Vendor {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String   @default("BILLABLE") // BILLABLE, CLINICAL
  contact   String?
  email     String?
  phone     String?
  gstin     String?
  address   String?
  paymentTerms String?
  creditDays   Int?
  bankName     String?
  bankAccount  String?
  isActive  Boolean  @default(true)
  products  Product[]
  pos       PurchaseOrder[]
  workOrders WorkOrder[]
  assetPOs   AssetPurchaseOrder[]
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  type        String   @default("BILLABLE") // BILLABLE, CLINICAL
  category    String?
  hsnCode     String?
  sacCode     String?
  unit        String   @default("PCS")
  mrp         Float    @default(0)
  costPrice   Float    @default(0)
  taxRate     Float    @default(18)
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  reorderLevel Int     @default(10)
  isActive    Boolean  @default(true)
  stocks      Stock[]
  poItems     POItem[]
  indentItems IndentItem[]
  stockMovements StockMovement[]
  clinicalConsumptions ClinicalConsumption[]
  grnItems    GRNItem[]
  stockTransferItems StockTransferItem[]
  stockOutwardItems  StockOutwardItem[]
  physicalAudits     PhysicalStockAudit[]
  salesOrderItems    SalesOrderItem[]
  factoryIndentItems FactoryIndentItem[]
  workOrderItems     WorkOrderItem[]
  productBatches     ProductBatch[]
  procedureConsumptions ProcedureConsumption[]
  createdAt   DateTime @default(now())
}

model Stock {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  batchNo    String?
  quantity   Int      @default(0)
  expiryDate DateTime?
  updatedAt  DateTime @updatedAt
  @@unique([productId, branchId, batchNo])
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNo            String   @unique
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  orderType       String   @default("STANDARD") // STANDARD, AESTHETICS, FACTORY, ASSET
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  factoryIndentId String?
  factoryIndent   FactoryIndent? @relation(fields: [factoryIndentId], references: [id])
  status          String   @default("DRAFT") // DRAFT, PENDING_AUTH, APPROVED, PARTIAL, RECEIVED, CANCELLED
  orderDate       DateTime @default(now())
  expectedDate    DateTime?
  totalAmount     Float    @default(0)
  notes           String?
  items           POItem[]
  grns            GRN[]
  createdAt       DateTime @default(now())
}

model POItem {
  id        String        @id @default(cuid())
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  received  Int           @default(0)
  totalAmount Float
}

model GRN {
  id              String        @id @default(cuid())
  grnNo           String        @unique
  poId            String
  po              PurchaseOrder @relation(fields: [poId], references: [id])
  grnType         String        @default("STANDARD") // STANDARD, AESTHETICS, FACTORY, ASSET
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  factoryIndentId String?
  factoryIndent   FactoryIndent? @relation(fields: [factoryIndentId], references: [id])
  receivedDate    DateTime      @default(now())
  status          String        @default("PENDING") // PENDING, QUALITY_CHECK, ACCEPTED, REJECTED
  notes           String?
  items           GRNItem[]
  bill            Bill?
  createdAt       DateTime      @default(now())
}

model GRNItem {
  id            String    @id @default(cuid())
  grnId         String
  grn           GRN       @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  quantity      Int
  batchNo       String?
  branchId      String?
  qualityStatus String    @default("PENDING") // PENDING, PASSED, FAILED
  qualityNotes  String?
  expiryDate    DateTime?
}

model Indent {
  id          String       @id @default(cuid())
  indentNo    String       @unique
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id])
  type        String       @default("BILLABLE") // BILLABLE, CLINICAL
  status      String       @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED, PARTIAL
