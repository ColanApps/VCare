<header class="erp-topbar">
  <div class="erp-topbar-left">
    <button type="button" class="erp-topbar-icon-btn lg:hidden" @click="mobileNav = !mobileNav" aria-label="Toggle navigation">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <a href="/dashboard/role-home" class="erp-topbar-brand">
      <div class="erp-topbar-brand-icon">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
      </div>
      <span class="erp-topbar-brand-text">{{ appName }}</span>
    </a>
    <a href="/dashboard" class="erp-topbar-modules hidden md:inline-flex">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      Modules
    </a>
  </div>

  <form action="/customer/search" method="GET" class="erp-topbar-search hidden md:flex">
    <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    <input type="search" name="q" placeholder="Search customers, bills, appointments…" class="erp-topbar-search-input" value="{{ query.q or '' }}">
  </form>

  <div class="erp-topbar-right">
    {% if isDev %}
    <span class="erp-env-pill hidden sm:inline-flex">DEMO</span>
    {% endif %}
    {% if user.branchName %}
    <span class="erp-branch-pill hidden lg:inline-flex" title="Branch">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
      {{ user.branchName }}
    </span>
    {% endif %}
    <a href="/dashboard/my-tasks" class="erp-topbar-notif" title="My tasks">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      {% if taskCount > 0 %}<span class="erp-notif-badge">{% if taskCount > 99 %}99+{% else %}{{ taskCount }}{% endif %}</span>{% endif %}
    </a>
    <button type="button" class="erp-topbar-notif" title="Notifications" aria-label="Notifications">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
    </button>
    <div class="relative" x-data="{ open: false }">
      <button type="button" @click="open = !open" class="erp-user-chip">
        <div class="erp-user-avatar">{{ user.firstName[0] }}{{ user.lastName[0] }}</div>
        <div class="hidden sm:block text-left min-w-0">
          <div class="text-sm font-semibold text-slate-900 truncate leading-tight">{{ user.fullName }}</div>
          <div class="text-xs text-slate-500 truncate">{{ user.email }}</div>
        </div>
        <svg class="w-4 h-4 text-slate-400 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div x-show="open" x-cloak @click.away="open = false" x-transition class="erp-user-menu">
        <div class="px-4 py-3 border-b border-surface-border">
          <div class="font-semibold text-sm text-slate-900">{{ user.fullName }}</div>
          <div class="text-xs text-slate-500">{{ user.roleName }}</div>
        </div>
        <div class="p-2">
          <a href="/dashboard/role-home" class="erp-user-menu-item">Role Home</a>
          <a href="/dashboard/my-tasks" class="erp-user-menu-item">My Tasks</a>
        </div>
        <div class="p-2 border-t border-surface-border">
          <form action="/auth/logout" method="POST">
            <button type="submit" class="erp-user-menu-item w-full text-red-600 hover:bg-red-50">Sign Out</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</header>
