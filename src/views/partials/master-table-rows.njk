{% from "macros/ui.njk" import emptyState, modalTrigger %}
{% for row in rows %}
<tr>
  {% for field in fields %}
  <td>{% set v = row[field] %}{% if v is number and ('amount' in field or 'Amount' in field or 'Cash' in field or 'Price' in field or field == 'value') %}{{ v | currency }}{% elif v and v.toISOString %}{{ v | date }}{% else %}{{ v or '—' }}{% endif %}</td>
  {% endfor %}
  <td class="text-xs text-slate-500">{% if row.createdAt %}{{ row.createdAt | date }}{% else %}—{% endif %}</td>
  {% if screen %}
  <td class="text-right whitespace-nowrap">
    {% if screen.model == 'incentiveUpload' %}
    <form method="POST" action="/registry/actions/incentive/{{ row.id }}/process" class="inline" onsubmit="return confirm('Calculate incentives for this period?')">
      <button type="submit" class="text-xs text-green-600 hover:underline">Calculate</button>
    </form>
    {% endif %}
    <button type="button" class="text-xs text-blue-600 hover:underline"
      hx-get="{{ screen.path }}/{{ row.id }}/form"
      hx-target="#erp-modal-body"
      hx-swap="innerHTML"
      @click="$dispatch('erp-open-modal', { title: 'Edit Record' })">Edit</button>
    <form method="POST" action="{{ screen.path }}/{{ row.id }}/delete" class="inline ml-2"
      hx-post="{{ screen.path }}/{{ row.id }}/delete"
      hx-target="#master-table-body"
      hx-swap="innerHTML"
      hx-confirm="Delete this record?">
      <button type="submit" class="text-xs text-red-600 hover:underline">Delete</button>
    </form>
  </td>
  {% endif %}
</tr>
{% else %}
{% if screen %}{{ emptyState('No records yet', fields.length + 2) }}{% else %}{{ emptyState('No records yet', fields.length + 1) }}{% endif %}
{% endfor %}
