<div class="erp-toast-stack" x-show="toasts.length" x-cloak>
  <template x-for="(toast, i) in toasts" :key="toast.id">
    <div class="erp-toast animate-slide-up" :class="toast.type === 'error' ? 'erp-toast-error' : toast.type === 'success' ? 'erp-toast-success' : 'erp-toast-info'">
      <span class="erp-toast-icon" :class="toast.type === 'error' ? 'erp-toast-icon-error' : toast.type === 'success' ? 'erp-toast-icon-success' : 'erp-toast-icon-info'">
        <template x-if="toast.type === 'success'">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </template>
        <template x-if="toast.type === 'error'">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </template>
        <template x-if="toast.type !== 'success' && toast.type !== 'error'">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </template>
      </span>
      <span class="text-sm font-medium text-slate-700" x-text="toast.message"></span>
      <button type="button" class="erp-toast-close" @click="dismissToast(toast.id)" aria-label="Dismiss">&times;</button>
      <span class="erp-toast-bar" :class="toast.type === 'error' ? 'erp-toast-bar-error' : toast.type === 'success' ? 'erp-toast-bar-success' : 'erp-toast-bar-info'"></span>
    </div>
  </template>
</div>

{% if flash %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    window.dispatchEvent(new CustomEvent('erp-flash', {
      detail: { type: '{{ flash.type }}', message: {{ flash.message | json | safe }} },
    }));
  });
</script>
{% endif %}
