{% if flash %}
<div class="mb-4 animate-fade-in" x-data="{ show: true }" x-show="show" x-init="setTimeout(() => show = false, 5000)">
  <div class="flex items-center gap-3 px-4 py-3 rounded-lg border {% if flash.type == 'success' %}bg-emerald-50 border-emerald-200 text-emerald-800{% elif flash.type == 'error' %}bg-red-50 border-red-200 text-red-800{% else %}bg-sky-50 border-sky-200 text-sky-800{% endif %}">
  {% if flash.type == 'success' %}
    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  {% else %}
    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  {% endif %}
    <span class="text-sm font-medium">{{ flash.message }}</span>
    <button @click="show = false" class="ml-auto opacity-60 hover:opacity-100">&times;</button>
  </div>
</div>
{% endif %}
