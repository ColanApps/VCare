{% from "macros/ui.njk" import formFooter %}
<form method="POST" action="/customer/register" class="erp-modal-form"
  hx-post="/customer/register" hx-swap="none">
  <div class="mb-6">
    <h3 class="font-semibold text-slate-900 mb-4 pb-2 border-b border-surface-border">Personal Information</h3>
    <div class="erp-form-grid">
      <div class="erp-field"><label class="erp-label">First Name *</label><input type="text" name="firstName" class="erp-input" required></div>
      <div class="erp-field"><label class="erp-label">Last Name *</label><input type="text" name="lastName" class="erp-input" required></div>
      <div class="erp-field">
        <label class="erp-label">Gender</label>
        <select name="gender" class="erp-select">
          <option value="">Select</option>
          <option value="MALE">Male</option>
          <option value="FEMALE">Female</option>
          <option value="OTHER">Other</option>
        </select>
      </div>
      <div class="erp-field"><label class="erp-label">Date of Birth</label><input type="date" name="dateOfBirth" class="erp-input"></div>
      <div class="erp-field"><label class="erp-label">Phone *</label><input type="tel" name="phone" class="erp-input" required></div>
      <div class="erp-field"><label class="erp-label">Alternate Phone</label><input type="tel" name="alternatePhone" class="erp-input"></div>
      <div class="erp-field"><label class="erp-label">Email</label><input type="email" name="email" class="erp-input"></div>
      <div class="erp-field"><label class="erp-label">Address</label><input type="text" name="address" class="erp-input"></div>
    </div>
  </div>

  <div class="mb-6">
    <h3 class="font-semibold text-slate-900 mb-4 pb-2 border-b border-surface-border">Clinic Details</h3>
    <div class="erp-form-grid">
      <div class="erp-field">
        <label class="erp-label">Branch *</label>
        <select name="branchId" class="erp-select" required>
          {% for b in branches %}<option value="{{ b.id }}">{{ b.name }}</option>{% endfor %}
        </select>
      </div>
      <div class="erp-field">
        <label class="erp-label">Category</label>
        <select name="category" class="erp-select">
          <option value="HAIR">Hair</option>
          <option value="SKIN">Skin</option>
        </select>
      </div>
      <div class="erp-field">
        <label class="erp-label">Occupation</label>
        <select name="occupationId" class="erp-select">
          <option value="">Select</option>
          {% for o in occupations %}<option value="{{ o.id }}">{{ o.name }}</option>{% endfor %}
        </select>
      </div>
      <div class="erp-field">
        <label class="erp-label">Known By</label>
        <select name="knownById" class="erp-select">
          <option value="">Select</option>
          {% for k in knownBy %}<option value="{{ k.id }}">{{ k.name }}</option>{% endfor %}
        </select>
      </div>
      <div class="erp-field">
        <label class="erp-label">Lead Source</label>
        <select name="leadSource" class="erp-select">
          <option value="">Select</option>
          <option value="WALK_IN">Walk-in</option>
          <option value="REFERRAL">Referral</option>
          <option value="ONLINE">Online</option>
          <option value="CALL_CENTER">Call Center</option>
          <option value="SOCIAL_MEDIA">Social Media</option>
        </select>
      </div>
    </div>
  </div>

  {{ formFooter() }}
</form>
