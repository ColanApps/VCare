{% from "macros/ui.njk" import formFooter %}
<form method="POST" action="/appointments/create" id="appointment-form" class="erp-modal-form"
  hx-post="/appointments/create" hx-swap="none">
  <div class="erp-form-grid">
    <div class="erp-field sm:col-span-2">
      <label class="erp-label">Customer *</label>
      <select name="customerId" id="customer-select" class="erp-select" required>
        <option value="" data-branch="">Select customer</option>
        {% for c in customers %}
        <option value="{{ c.id }}" data-branch="{{ c.branchId }}" {% if preselectedCustomer == c.id %}selected{% endif %}>{{ c.firstName }} {{ c.lastName }} ({{ c.uhid }})</option>
        {% endfor %}
      </select>
    </div>
    {% if showBranchPicker %}
    <div class="erp-field">
      <label class="erp-label">Branch *</label>
      <select name="branchId" id="branch-select" class="erp-select" required>
        <option value="">Select branch</option>
        {% for b in branches %}
        <option value="{{ b.id }}" {% if user.branchId == b.id %}selected{% endif %}>{{ b.name }}</option>
        {% endfor %}
      </select>
    </div>
    {% endif %}
    <div class="erp-field">
      <label class="erp-label">Consultant</label>
      <select name="consultantId" class="erp-select">
        <option value="">Any available</option>
        {% for c in consultants %}<option value="{{ c.id }}">{{ c.firstName }} {{ c.lastName }}</option>{% endfor %}
      </select>
    </div>
    <div class="erp-field">
      <label class="erp-label">Treatment</label>
      <select name="treatmentId" class="erp-select">
        <option value="">None</option>
        {% for t in treatments %}<option value="{{ t.id }}">{{ t.name }}</option>{% endfor %}
      </select>
    </div>
    <div class="erp-field">
      <label class="erp-label">Type</label>
      <select name="type" class="erp-select">
        <option value="CONSULTATION">Consultation</option><option value="TREATMENT">Treatment</option>
        <option value="PROCEDURE">Procedure</option><option value="FOLLOW_UP">Follow Up</option>
      </select>
    </div>
    <div class="erp-field">
      <label class="erp-label">Category</label>
      <select name="category" class="erp-select"><option value="HAIR">Hair</option><option value="SKIN">Skin</option></select>
    </div>
    <div class="erp-field">
      <label class="erp-label">Date & Time *</label>
      <input type="datetime-local" name="scheduledAt" id="appointment-scheduled-at" class="erp-input" required>
    </div>
    <div class="erp-field">
      <label class="erp-label">Duration (mins)</label>
      <input type="number" name="duration" class="erp-input" value="30">
    </div>
    <div class="erp-field">
      <label class="erp-label">Source</label>
      <select name="source" class="erp-select">
        <option value="WALK_IN">Walk-in</option><option value="CALL_CENTER">Call Center</option>
        <option value="ONLINE">Online</option><option value="REFERRAL">Referral</option>
      </select>
    </div>
    <div class="erp-field"><label class="erp-label">Lead Source</label><input type="text" name="leadSource" class="erp-input"></div>
    <div class="erp-field"><label class="erp-label">Campaign</label><input type="text" name="campaign" class="erp-input"></div>
    <div class="erp-field sm:col-span-2"><label class="erp-label">Notes</label><textarea name="notes" class="erp-input" rows="2"></textarea></div>
  </div>
  {{ formFooter('/appointments') }}
</form>
<script>
window.initAppointmentCreateForm = function initAppointmentCreateForm() {
  const dt = document.getElementById('appointment-scheduled-at');
  if (dt && !dt.value) {
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    dt.value = now.toISOString().slice(0, 16);
  }
  window.initBranchCustomerSync?.();
};
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => window.initAppointmentCreateForm?.());
} else {
  window.initAppointmentCreateForm?.();
}
</script>
