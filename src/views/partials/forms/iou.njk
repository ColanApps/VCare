{% from "macros/ui.njk" import formFooter %}
<form method="POST" action="/operations/iou" enctype="multipart/form-data" class="erp-modal-form"
  hx-post="/operations/iou" hx-encoding="multipart/form-data" hx-swap="none">
  <div class="erp-form-grid max-w-lg">
    <div class="erp-field">
      <label class="erp-label">Amount (₹) *</label>
      <input type="number" name="amount" class="erp-input" step="0.01" required data-currency>
    </div>
    <div class="erp-field sm:col-span-2">
      <label class="erp-label">Purpose *</label>
      <textarea name="purpose" class="erp-input" rows="3" required placeholder="Describe the purpose of this advance…"></textarea>
    </div>
    <div class="erp-field sm:col-span-2">
      <label class="erp-label">Supporting document</label>
      <input type="file" name="attachment" class="erp-input text-sm" accept="image/*,.pdf">
    </div>
  </div>
  {{ formFooter() }}
</form>
