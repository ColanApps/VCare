{% from "macros/ui.njk" import formFooter %}
<form method="POST" action="/purchase/asset-po" class="erp-modal-form" hx-post="/purchase/asset-po" hx-swap="none">
  <div class="erp-form-grid">
    <div class="erp-field">
      <label class="erp-label">Vendor</label>
      <select name="vendorId" class="erp-select">
        <option value="">— Optional —</option>
        {% for v in vendors %}<option value="{{ v.id }}">{{ v.name }}</option>{% endfor %}
      </select>
    </div>
    <div class="erp-field sm:col-span-2"><label class="erp-label">Notes</label><textarea name="notes" class="erp-input" rows="2"></textarea></div>
  </div>
  <div class="erp-card mt-4 p-4">
    <div class="flex flex-wrap gap-2 mb-3">
      <input type="text" id="aspo-desc" class="erp-input text-sm flex-1" placeholder="Asset description">
      <input type="number" id="aspo-qty" class="erp-input w-20 text-sm" value="1" min="1">
      <input type="number" id="aspo-cost" class="erp-input w-28 text-sm" step="0.01" placeholder="Unit cost">
      <button type="button" onclick="addAspoLine()" class="erp-btn-secondary text-sm">Add</button>
    </div>
    <table class="erp-table text-sm"><thead><tr><th>Description</th><th>Qty</th><th>Unit Cost</th><th></th></tr></thead>
    <tbody id="aspo-lines"><tr><td colspan="4" class="erp-empty-cell">Add asset lines</td></tr></tbody></table>
    <input type="hidden" name="items" id="aspo-items-json" value="[]">
  </div>
  {{ formFooter() }}
</form>
<script>
const aspoItems = [];
function refreshAspo() {
  document.getElementById('aspo-items-json').value = JSON.stringify(aspoItems);
  document.getElementById('aspo-lines').innerHTML = aspoItems.length
    ? aspoItems.map((i, idx) => `<tr><td>${i.description}</td><td>${i.quantity}</td><td>₹${i.unitCost}</td><td><button type="button" class="text-red-500 text-xs" onclick="aspoItems.splice(${idx},1);refreshAspo()">Remove</button></td></tr>`).join('')
    : '<tr><td colspan="4" class="erp-empty-cell">Add asset lines</td></tr>';
}
function addAspoLine() {
  aspoItems.push({
    description: document.getElementById('aspo-desc').value || 'Asset',
    quantity: parseInt(document.getElementById('aspo-qty').value, 10) || 1,
    unitCost: parseFloat(document.getElementById('aspo-cost').value) || 0,
  });
  refreshAspo();
}
</script>
