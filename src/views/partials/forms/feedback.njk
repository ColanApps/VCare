{% from "macros/ui.njk" import formFooter %}
<form method="POST" action="/customer/treatment/feedback" enctype="multipart/form-data" class="erp-modal-form"
  hx-post="/customer/treatment/feedback" hx-encoding="multipart/form-data" hx-swap="none">
  <div class="erp-form-grid">
    <div class="erp-field">
      <label class="erp-label">Visit *</label>
      <select name="visitId" class="erp-select" required id="visit-select">
        <option value="">Select visit without feedback</option>
        {% for v in visits %}
        <option value="{{ v.id }}" data-customer="{{ v.customerId }}">{{ v.visitNo }} — {{ v.customer.firstName }} ({{ v.visitedAt | date }})</option>
        {% endfor %}
      </select>
    </div>
    <input type="hidden" name="customerId" id="customer-id">
    <div class="erp-field">
      <label class="erp-label">Rating (1–5)</label>
      <select name="rating" class="erp-select">
        <option value="">No rating</option>
        {% for r in range(1, 6) %}<option value="{{ r }}">{{ r }} ★</option>{% endfor %}
      </select>
    </div>
    <div class="erp-field sm:col-span-2">
      <label class="erp-label">Feedback</label>
      <textarea name="feedback" class="erp-input" rows="3" required></textarea>
    </div>
    <div class="erp-field sm:col-span-2">
      <label class="erp-label">Attachment</label>
      <input type="file" name="attachment" class="erp-input text-sm" accept="image/*,.pdf">
    </div>
  </div>
  {{ formFooter() }}
</form>
<script>
document.getElementById('visit-select')?.addEventListener('change', function() {
  document.getElementById('customer-id').value = this.selectedOptions[0]?.dataset.customer || '';
});
</script>
