{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Treatment Calendar') %}
{% endcall %}

<form method="GET" class="erp-filter-bar mb-6">
  <div class="erp-field">
    <label class="erp-label">Date</label>
    <input type="date" name="date" value="{{ selectedDate }}" class="erp-input">
  </div>
  <button type="submit" class="erp-btn-secondary">View Day</button>
</form>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead><tr><th>Time</th><th>Customer</th><th>Branch</th><th>Consultant</th><th>Type</th><th>Status</th></tr></thead>
    <tbody>
      {% for a in appointments %}
      <tr>
        <td class="text-xs whitespace-nowrap">{{ a.scheduledAt | datetime }}</td>
        <td>
          <a href="/customer/{{ a.customer.id }}" class="font-medium text-accent-600 hover:underline">{{ a.customer.firstName }} {{ a.customer.lastName }}</a>
          <div class="text-[10px] text-slate-400">{{ a.customer.phone }}</div>
        </td>
        <td>{{ a.branch.name }}</td>
        <td>{% if a.consultant %}{{ a.consultant.firstName }} {{ a.consultant.lastName }}{% else %}—{% endif %}</td>
        <td><span class="erp-badge-neutral">{{ a.type }}</span></td>
        <td>{{ statusBadge(a.status) }}</td>
      </tr>
      {% else %}
      <tr><td colspan="6" class="erp-empty-cell">No appointments on this day</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
