{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Call Back Schedule') %}
{% endcall %}
<p class="text-sm text-slate-500 mb-6">Upcoming callback follow-ups</p>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Phone</th>
          <th>Scheduled At</th>
          <th>Feedback</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for cb in callbacks %}
        <tr>
          <td>
            <a href="/customer/{{ cb.customer.id }}" class="hover:underline font-medium">{{ cb.customer.firstName }} {{ cb.customer.lastName }}</a>
            <div class="text-[10px] text-slate-400 font-mono">{{ cb.customer.uhid }}</div>
          </td>
          <td class="font-mono text-xs">{{ cb.customer.phone }}</td>
          <td class="text-xs font-medium">{{ cb.scheduledAt | datetime }}</td>
          <td class="text-sm text-slate-600 max-w-xs truncate">{{ cb.feedback or '—' }}</td>
          <td>{{ statusBadge(cb.status) }}</td>
          <td>
            <a href="/call-center/follow-ups?q={{ cb.customer.phone }}" class="erp-btn-secondary text-xs">View</a>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="erp-empty-cell">No callbacks scheduled</td></tr>
        {% endfor %}
      </tbody>
    </table>
</div>
</div>
{% endblock %}
