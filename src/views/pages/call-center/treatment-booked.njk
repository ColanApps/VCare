{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Treatment Booked') %}
{% endcall %}
<p class="text-sm text-slate-500 mb-6">Scheduled and confirmed treatment appointments</p>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
      <thead>
        <tr>
          <th>Appointment No</th>
          <th>Customer</th>
          <th>Consultant</th>
          <th>Branch</th>
          <th>Scheduled</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for apt in appointments %}
        <tr>
          <td class="font-mono text-xs font-medium">{{ apt.appointmentNo }}</td>
          <td>
            <a href="/customer/{{ apt.customer.id }}" class="hover:underline font-medium">{{ apt.customer.firstName }} {{ apt.customer.lastName }}</a>
            <div class="text-[10px] text-slate-400 font-mono">{{ apt.customer.uhid }} · {{ apt.customer.phone }}</div>
          </td>
          <td>{% if apt.consultant %}{{ apt.consultant.firstName }} {{ apt.consultant.lastName }}{% else %}—{% endif %}</td>
          <td>{{ apt.branch.name }}</td>
          <td class="text-xs">{{ apt.scheduledAt | datetime }}</td>
          <td>{{ statusBadge(apt.status) }}</td>
          <td>
            <a href="/appointments/search?q={{ apt.appointmentNo }}" class="erp-btn-secondary text-xs">View</a>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="7" class="erp-empty-cell">No treatment appointments booked</td></tr>
        {% endfor %}
      </tbody>
    </table>
</div>
</div>
{% endblock %}
