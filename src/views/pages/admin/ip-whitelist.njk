{% extends "layouts/main.njk" %}
{% block content %}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="erp-card">
    <div class="erp-card-header">
      <h3 class="font-semibold text-slate-900">Add IP Address</h3>
    </div>
    <form method="POST" action="/admin/ip-whitelist" class="erp-card-body space-y-4">
      <div>
        <label class="erp-label">IP Address</label>
        <input type="text" name="ipAddress" class="erp-input font-mono" placeholder="192.168.1.100" required>
      </div>
      <div>
        <label class="erp-label">Description</label>
        <input type="text" name="description" class="erp-input" placeholder="Office network, VPN, etc.">
      </div>
      <button type="submit" class="erp-btn-primary w-full">Add to Whitelist</button>
    </form>
  </div>

  <div class="lg:col-span-2 erp-card">
    <div class="erp-card-header">
      <h3 class="font-semibold text-slate-900">Whitelisted IPs</h3>
      <span class="text-xs text-slate-500">{{ entries | length }} entries</span>
    </div>
    <div class="overflow-x-auto">
      <table class="erp-table">
        <thead>
          <tr>
            <th>IP Address</th>
            <th>Description</th>
            <th>Status</th>
            <th>Added</th>
          </tr>
        </thead>
        <tbody>
          {% for entry in entries %}
          <tr>
            <td class="font-mono font-medium">{{ entry.ipAddress }}</td>
            <td>{{ entry.description or '—' }}</td>
            <td>{% if entry.isActive %}<span class="erp-badge-success">Active</span>{% else %}<span class="erp-badge-danger">Inactive</span>{% endif %}</td>
            <td class="text-xs text-slate-500">{{ entry.createdAt | datetime }}</td>
          </tr>
          {% else %}
          <tr><td colspan="4" class="text-center text-slate-400 py-8">No IP addresses whitelisted</td></tr>
          {% endfor %}
        </tbody>
      </table>
  </div>
  </div>
</div>
{% endblock %}
