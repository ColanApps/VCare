{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Roles & Access Control') %}
{% endcall %}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-1 space-y-4">
    {% for role in roles %}
    <div class="erp-card {% if editRoleId == role.id %}ring-2 ring-accent-400{% endif %}">
      <div class="erp-card-body">
        <div class="flex items-start justify-between mb-2">
          <div>
            <h3 class="font-semibold text-slate-900">{{ role.name }}</h3>
            <span class="text-xs text-slate-500">{{ role.code }} · Level {{ role.level }}</span>
          </div>
          <span class="erp-badge-neutral">{{ role._count.users }} users</span>
        </div>
        <p class="text-sm text-slate-600 mb-3">{{ role.description or 'No description' }}</p>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs">
            <span class="font-medium text-accent-600">{{ role.permissions | length }}</span>
            <span class="text-slate-500">permissions assigned</span>
          </div>
          <a href="/admin/roles?role={{ role.id }}" class="text-xs text-accent-600 hover:underline">Edit permissions</a>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="lg:col-span-2 space-y-6">
    {% if editRoleId %}
    {% set editRole = roles | selectattr('id', 'equalto', editRoleId) | list | first %}
    {% if editRole %}
    <div class="erp-card">
      <div class="erp-card-header">
        <h3 class="font-semibold text-slate-900">Edit Permissions — {{ editRole.name }}</h3>
        <a href="/admin/roles" class="text-xs text-slate-500 hover:underline">Close</a>
      </div>
      <form method="POST" action="/admin/roles/{{ editRole.id }}/permissions" class="erp-card-body">
        <div class="space-y-6 max-h-[60vh] overflow-y-auto pr-2">
          {% for module, perms in permissionsByModule %}
          <div>
            <h4 class="text-sm font-semibold text-slate-700 mb-3 pb-2 border-b border-surface-border">{{ module }}</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {% for perm in perms %}
              <label class="flex items-start gap-2 p-2 rounded-lg hover:bg-slate-50 cursor-pointer text-sm">
                <input type="checkbox" name="permissionIds" value="{{ perm.id }}" class="mt-0.5 rounded border-slate-300 text-accent-600"
                  {% for rp in editRole.permissions %}{% if rp.permission.id == perm.id %}checked{% endif %}{% endfor %}>
                <span>
                  <span class="font-medium text-slate-800">{{ perm.action }}</span>
                  <span class="block text-[10px] font-mono text-slate-400">{{ perm.code }}</span>
                </span>
              </label>
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
        <div class="mt-6 flex gap-3 pt-4 border-t border-surface-border">
          <button type="submit" class="erp-btn-primary">Save Permissions</button>
          <a href="/admin/roles" class="erp-btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
    {% endif %}
    {% endif %}

    <div class="erp-card">
      <div class="erp-card-header">
        <h3 class="font-semibold text-slate-900">Permission Matrix</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="erp-table text-xs">
          <thead>
            <tr>
              <th>Module</th>
              <th>Action</th>
              <th>Code</th>
              {% for role in roles %}
              <th class="text-center">{{ role.code }}</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for perm in permissions %}
            <tr>
              <td class="font-medium">{{ perm.module }}</td>
              <td>{{ perm.action }}</td>
              <td class="font-mono text-slate-500">{{ perm.code }}</td>
              {% for role in roles %}
              <td class="text-center">
                {% for rp in role.permissions %}
                  {% if rp.permission.code == perm.code %}<span class="text-emerald-600">✓</span>{% endif %}
                {% endfor %}
              </td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
    </div>
    </div>
  </div>
</div>
{% endblock %}
