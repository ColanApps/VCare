{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Online Orders Integration') %}
{% endcall %}
<p class="text-sm text-slate-500 mb-6">Orders received via <code class="text-xs bg-slate-100 px-1 rounded">POST /api/v1/online-orders</code></p>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table text-sm">
    <thead>
      <tr><th>Order No</th><th>Customer</th><th>Phone</th><th>Amount</th><th>Payment</th><th>Status</th><th>Bill</th><th>Created</th><th>Error</th></tr>
    </thead>
    <tbody>
      {% for o in orders %}
      <tr>
        <td class="font-mono text-xs font-medium">{{ o.orderNo }}</td>
        <td>{{ o.customerName }}</td>
        <td>{{ o.customerPhone }}</td>
        <td>{{ o.totalAmount | currency }}</td>
        <td><span class="erp-badge-neutral">{{ o.paymentStatus }}</span></td>
        <td>{{ statusBadge(o.status) }}</td>
        <td>{% if o.billId and billMap[o.billId] %}<a href="/billing/{{ o.billId }}" class="text-accent-600 font-mono text-xs">{{ billMap[o.billId].billNo }}</a>{% else %}—{% endif %}</td>
        <td class="text-xs text-slate-500">{{ o.createdAt | datetime }}</td>
        <td class="text-xs text-red-600 max-w-xs truncate">{{ o.errorMessage or '—' }}</td>
      </tr>
      {% else %}
      <tr><td colspan="9" class="erp-empty-cell">No online orders yet</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
