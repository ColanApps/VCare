{% extends "layouts/main.njk" %}
{% block content %}
<div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
  <div class="text-6xl font-light text-slate-200 mb-4">{{ code }}</div>
  <h2 class="text-xl font-semibold text-slate-800 mb-2">{{ title }}</h2>
  <p class="text-slate-500 max-w-md">{{ message }}</p>
  <a href="/home" class="erp-btn-primary mt-6">Return to Portal</a>
</div>
{% endblock %}
