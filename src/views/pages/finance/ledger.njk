{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('General Ledger', 'Double-entry journal — debit / credit postings from bills & payments') %}
  <a href="/finance" class="erp-btn-secondary text-sm">Finance Hub</a>
{% endcall %}

<div class="space-y-4">
  {% for entry in entries %}
  <div class="erp-card">
    <div class="erp-card-header flex flex-wrap justify-between gap-2">
      <div>
        <span class="font-mono text-sm font-semibold">{{ entry.entryNo }}</span>
        <span class="text-xs text-slate-500 ml-2">{{ entry.entryDate | date }}</span>
      </div>
      <div class="text-xs text-slate-600">
        {{ entry.sourceType }} · {{ entry.branch.name }} · {{ entry.description or '—' }}
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="erp-table text-sm">
        <thead><tr><th>Account</th><th>Code</th><th class="text-right">Debit</th><th class="text-right">Credit</th><th>Memo</th></tr></thead>
        <tbody>
          {% for line in entry.lines %}
          <tr>
            <td>{{ line.account.name }}</td>
            <td class="font-mono text-xs">{{ line.account.code }}</td>
            <td class="text-right">{% if line.debit > 0 %}{{ line.debit | currency }}{% else %}—{% endif %}</td>
            <td class="text-right">{% if line.credit > 0 %}{{ line.credit | currency }}{% else %}—{% endif %}</td>
            <td class="text-xs text-slate-500">{{ line.memo or '—' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% else %}
  <div class="erp-card p-8 text-center text-slate-400">No journal entries yet — post a bill or payment to see ledger entries.</div>
  {% endfor %}
</div>
{% endblock %}
