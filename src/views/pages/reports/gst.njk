{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('GST Summary (HSN)', period.start | date ~ ' – ' ~ period.end | date) %}
{% endcall %}

<div class="erp-kpi-grid erp-kpi-grid-auto mb-6" style="grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));">
  <div class="erp-kpi">
    <div class="erp-kpi-label">Total Tax Collected</div>
    <div class="erp-kpi-value mt-1">{{ totalTax | currency }}</div>
  </div>
  <div class="erp-kpi">
    <div class="erp-kpi-label">Gross Revenue</div>
    <div class="erp-kpi-value mt-1">{{ totalRevenue | currency }}</div>
  </div>
  <div class="erp-kpi">
    <div class="erp-kpi-label">HSN Codes</div>
    <div class="erp-kpi-value mt-1">{{ hsnSummary | length | number }}</div>
  </div>
</div>

<div class="erp-card erp-table-card">
  <div class="erp-card-header">
    <h3 class="font-semibold">HSN-wise Summary</h3>
  </div>
  <div class="overflow-x-auto">
    <table class="erp-table">
      <thead>
        <tr>
          <th>HSN / Item Code</th>
          <th>Item Name</th>
          <th>Taxable Value</th>
          <th>Tax Amount</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {% for h in hsnSummary %}
        <tr>
          <td class="font-mono text-xs font-medium">{{ h.code }}</td>
          <td>{{ h.name }}</td>
          <td>{{ h.taxable | currency }}</td>
          <td>{{ h.tax | currency }}</td>
          <td class="font-medium">{{ h.total | currency }}</td>
        </tr>
        {% else %}
        <tr><td colspan="5" class="erp-empty-cell">No GST data for this period</td></tr>
        {% endfor %}
      </tbody>
      {% if hsnSummary | length > 0 %}
      <tfoot>
        <tr class="bg-slate-50 font-semibold">
          <td colspan="3" class="text-right">Total Tax</td>
          <td>{{ totalTax | currency }}</td>
          <td></td>
        </tr>
      </tfoot>
      {% endif %}
    </table>
</div>
</div>
{% endblock %}
