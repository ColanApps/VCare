{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('GST Report — B2C', 'Center & online consumer bills · ' ~ period.start | date ~ ' – ' ~ period.end | date) %}
{% endcall %}

<div class="erp-kpi-grid erp-kpi-grid-auto mb-6" style="grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));">
  <div class="erp-kpi">
    <div class="erp-kpi-label">B2C Bills</div>
    <div class="erp-kpi-value mt-1">{{ bills | length | number }}</div>
  </div>
  <div class="erp-kpi">
    <div class="erp-kpi-label">Taxable + Tax</div>
    <div class="erp-kpi-value mt-1">{{ total | currency }}</div>
  </div>
  <div class="erp-kpi">
    <div class="erp-kpi-label">GST Collected</div>
    <div class="erp-kpi-value mt-1">{{ totalTax | currency }}</div>
  </div>
</div>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead>
      <tr><th>Bill No</th><th>Date</th><th>Customer</th><th>Branch</th><th>Type</th><th>Taxable</th><th>Tax</th><th>Total</th><th>Status</th></tr>
    </thead>
    <tbody>
      {% for b in bills %}
      <tr>
        <td class="font-mono text-xs"><a href="/billing/{{ b.id }}" class="text-accent-600 hover:underline">{{ b.billNo }}</a></td>
        <td class="text-xs">{{ b.billDate | date }}</td>
        <td>{{ b.customer.firstName }} {{ b.customer.lastName }}</td>
        <td class="text-sm">{{ b.branch.name }}</td>
        <td><span class="erp-badge-neutral">{{ b.billType or 'SERVICE' }}</span></td>
        <td>{{ b.subtotal | currency }}</td>
        <td>{{ b.taxAmount | currency }}</td>
        <td class="font-medium">{{ b.totalAmount | currency }}</td>
        <td>{{ statusBadge(b.status) }}</td>
      </tr>
      {% else %}
      <tr><td colspan="9" class="erp-empty-cell">No B2C bills this month</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
