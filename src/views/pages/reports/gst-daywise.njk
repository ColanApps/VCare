{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Day Wise GST Report', period.start | date ~ ' – ' ~ period.end | date) %}
{% endcall %}

{% set grandBills = totals.bills %}
{% set grandTax = totals.tax %}
{% set grandTotal = totals.total %}

<div class="erp-kpi-grid erp-kpi-grid-auto mb-6" style="grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));">
  <div class="erp-kpi">
    <div class="erp-kpi-label">Total Bills</div>
    <div class="erp-kpi-value mt-1">{{ grandBills | number }}</div>
  </div>
  <div class="erp-kpi">
    <div class="erp-kpi-label">Total GST</div>
    <div class="erp-kpi-value mt-1">{{ grandTax | currency }}</div>
  </div>
  <div class="erp-kpi">
    <div class="erp-kpi-label">Gross Revenue</div>
    <div class="erp-kpi-value mt-1">{{ grandTotal | currency }}</div>
  </div>
</div>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead>
      <tr><th>Date</th><th>Bills</th><th>Taxable Value</th><th>GST</th><th>Total</th></tr>
    </thead>
    <tbody>
      {% for r in rows %}
      <tr class="{% if r.bills == 0 %}text-slate-400{% endif %}">
        <td class="font-medium">{{ r.label }}</td>
        <td>{{ r.bills }}</td>
        <td>{{ r.taxable | currency }}</td>
        <td>{{ r.tax | currency }}</td>
        <td class="font-medium">{{ r.total | currency }}</td>
      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr class="bg-slate-50 font-semibold">
        <td>Month Total</td>
        <td>{{ grandBills }}</td>
        <td>—</td>
        <td>{{ grandTax | currency }}</td>
        <td>{{ grandTotal | currency }}</td>
      </tr>
    </tfoot>
  </table>
  </div>
</div>
{% endblock %}
