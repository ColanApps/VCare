{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% from "partials/report-filters.njk" import reportPeriodFilter %}
{% block content %}
{% call pageToolbar('Sales Report', period.from | date ~ ' — ' ~ (period.to | date)) %}
  <a href="/reports/sales/export" class="erp-btn-secondary text-sm">Export</a>
{% endcall %}
{{ reportPeriodFilter('/reports/sales', period, branches) }}

<div class="erp-kpi-grid erp-kpi-grid-auto mb-6" style="grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));">
  <div class="erp-kpi">
    <div class="erp-kpi-label">Total Revenue</div>
    <div class="erp-kpi-value mt-1">{{ summary.totalRevenue | currency }}</div>
    <div class="text-xs text-slate-400 mt-2">{{ summary.billCount | number }} bills</div>
  </div>
  <div class="erp-kpi">
    <div class="erp-kpi-label">Collected</div>
    <div class="erp-kpi-value mt-1">{{ summary.totalCollected | currency }}</div>
    <div class="text-xs text-emerald-600 mt-2">{{ ((summary.totalCollected / summary.totalRevenue * 100) if summary.totalRevenue > 0 else 0) | round(1) }}% collection rate</div>
  </div>
  <div class="erp-kpi">
    <div class="erp-kpi-label">Outstanding</div>
    <div class="erp-kpi-value mt-1">{{ (summary.totalRevenue - summary.totalCollected) | currency }}</div>
  </div>
</div>

<div class="erp-pair-grid mb-6">
  <div class="erp-card">
    <div class="erp-card-header"><h3 class="font-semibold">Revenue by Branch</h3></div>
    <div class="erp-card-body">
      <div class="erp-chart-wrap erp-chart-wrap-md">
        <canvas id="branchChart"></canvas>
      </div>
    </div>
  </div>
  <div class="erp-card h-fit self-start">
    <div class="erp-card-header"><h3 class="font-semibold">Payment Mode Split</h3></div>
    <div class="erp-card-body space-y-3">
      {% for row in summary.paymentModes %}
      <div>
        <div class="flex justify-between text-xs mb-1">
          <span class="font-medium">{{ row.mode }}</span>
          <span>{{ row.amount | currency }}</span>
        </div>
        <div class="erp-stat-bar">
          <div class="erp-stat-bar-fill" style="width: {{ row.pct | round(1) }}%"></div>
        </div>
      </div>
      {% else %}
      <p class="text-sm text-slate-500">No payment data for this period.</p>
      {% endfor %}
    </div>
  </div>
</div>

<div class="erp-card erp-table-card">
  <div class="erp-card-header"><h3 class="font-semibold">Bill Details</h3></div>
  <div class="overflow-x-auto">
    <table class="erp-table">
      <thead>
        <tr><th>Bill No</th><th>Date</th><th>Customer</th><th>Branch</th><th>Total</th><th>Paid</th><th>Status</th></tr>
      </thead>
      <tbody>
        {% for bill in bills %}
        <tr>
          <td class="font-mono text-xs"><a href="/billing/{{ bill.id }}" class="text-accent-600 hover:underline">{{ bill.billNo }}</a></td>
          <td class="text-xs">{{ bill.billDate | date }}</td>
          <td>{{ bill.customer.firstName }} {{ bill.customer.lastName }}</td>
          <td>{{ bill.branch.name }}</td>
          <td class="font-medium">{{ bill.totalAmount | currency }}</td>
          <td>{{ bill.paidAmount | currency }}</td>
          <td>{{ statusBadge(bill.status) }}</td>
        </tr>
        {% else %}
        <tr><td colspan="7" class="erp-empty-cell">No bills this period</td></tr>
        {% endfor %}
      </tbody>
    </table>
</div>
</div>
{% endblock %}

{% block scripts %}
<script>
  const branchData = {{ summary.byBranch | json | safe }};
  erpCreateChart('branchChart', {
    type: 'bar',
    data: {
      labels: Object.keys(branchData),
      datasets: [{
        label: 'Revenue',
        data: Object.values(branchData),
        backgroundColor: 'rgba(20, 184, 154, 0.7)',
        borderRadius: 6,
      }]
    },
    options: {
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, ticks: { callback: v => '₹' + (v/1000).toFixed(0) + 'K' } }
      }
    }
  });
</script>
{% endblock %}
