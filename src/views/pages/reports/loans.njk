{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% from "partials/report-filters.njk" import reportPeriodFilter %}
{% block content %}
{% call pageToolbar('Loan Report') %}
{% endcall %}
{{ reportPeriodFilter('/reports/loans', period) }}
<p class="text-sm text-slate-500 mb-6">{{ period.from | date }} — {{ period.to | date }}</p>

<div class="erp-kpi-grid erp-kpi-grid-auto mb-6" style="grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));">
  <div class="erp-kpi"><div class="erp-kpi-label">Active Loans</div><div class="erp-kpi-value mt-1">{{ summary.count }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">Principal</div><div class="erp-kpi-value mt-1">{{ summary.principal | currency }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">Outstanding</div><div class="erp-kpi-value mt-1">{{ summary.outstanding | currency }}</div></div>
</div>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead><tr><th>Loan No</th><th>Customer</th><th>Bill</th><th>Principal</th><th>EMI</th><th>Paid</th><th>Status</th><th>Installments</th></tr></thead>
    <tbody>
      {% for l in loans %}
      <tr>
        <td class="font-mono text-xs">{{ l.loanNo }}</td>
        <td>{{ l.customer.firstName }} {{ l.customer.lastName }}</td>
        <td class="font-mono text-xs">{% if l.bill %}<a href="/billing/{{ l.bill.id }}" class="text-accent-600">{{ l.bill.billNo }}</a>{% else %}—{% endif %}</td>
        <td>{{ l.principal | currency }}</td>
        <td>{{ l.emiAmount | currency }}</td>
        <td>{{ l.paidAmount | currency }}</td>
        <td>{{ statusBadge(l.status) }}</td>
        <td class="text-xs">{{ l.installments | length }} EMIs</td>
      </tr>
      {% else %}
      <tr><td colspan="8" class="erp-empty-cell">No loans in period</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
