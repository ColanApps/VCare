{% extends "layouts/main.njk" %}
{% from "partials/report-filters.njk" import reportPeriodFilter %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Appointments & Visits') %}
{% endcall %}
{{ reportPeriodFilter('/reports/appointments-visits', period) }}
<p class="text-sm text-slate-500 mb-6">{{ period.from | date }} — {{ period.to | date }}</p>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
  <div class="erp-kpi">
    <div class="erp-kpi-label">Treatment Visits</div>
    <div class="erp-kpi-value mt-1">{{ visits | number }}</div>
  </div>
  <div class="erp-card erp-table-card">
    <div class="erp-card-header"><h3 class="font-semibold">Appointments by Status</h3></div>
      <div class="overflow-x-auto">
        <table class="erp-table">
      <thead><tr><th>Status</th><th>Count</th></tr></thead>
      <tbody>
        {% for a in appointments %}
        <tr><td><span class="erp-badge-neutral">{{ a.status }}</span></td><td class="font-medium">{{ a._count }}</td></tr>
        {% else %}
        <tr><td colspan="2" class="erp-empty-cell">No appointments</td></tr>
        {% endfor %}
      </tbody>
    </table>
</div>
</div>
{% endblock %}
