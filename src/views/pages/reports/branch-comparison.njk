{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Branch Comparison', period.start | date ~ ' – ' ~ period.end | date) %}
{% endcall %}

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="erp-kpi"><div class="erp-kpi-label">Total Revenue</div><div class="erp-kpi-value mt-1">{{ totals.revenue | currency }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">Collected</div><div class="erp-kpi-value mt-1">{{ totals.collected | currency }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">Total Bills</div><div class="erp-kpi-value mt-1">{{ totals.billCount }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">New Customers</div><div class="erp-kpi-value mt-1">{{ totals.newCustomers }}</div></div>
</div>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead>
      <tr><th>Branch</th><th>Zone</th><th>Revenue</th><th>Collected</th><th>GST</th><th>Bills</th><th>Paid</th><th>New Cust.</th><th>Target</th><th>Achievement</th></tr>
    </thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td class="font-medium">{{ r.branch.name }}</td>
        <td class="text-sm text-slate-500">{% if r.branch.zone %}{{ r.branch.zone.name }}{% else %}—{% endif %}</td>
        <td class="font-medium">{{ r.revenue | currency }}</td>
        <td class="text-emerald-600">{{ r.collected | currency }}</td>
        <td>{{ r.tax | currency }}</td>
        <td>{{ r.billCount }}</td>
        <td>{{ r.paidBills }}</td>
        <td>{{ r.newCustomers }}</td>
        <td>{{ r.target | currency }}</td>
        <td>
          <span class="{% if r.achievement >= 100 %}text-emerald-600{% elif r.achievement >= 75 %}text-amber-600{% else %}text-red-600{% endif %} font-medium">
            {{ r.achievement | round(1) }}%
          </span>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
