{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Biometric Attendance') %}
{% endcall %}

<div class="erp-kpi-grid erp-kpi-grid-auto mb-6" style="grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));">
  <div class="erp-kpi"><div class="erp-kpi-label">Present Today</div><div class="erp-kpi-value mt-1 text-emerald-600">{{ presentCount }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">Absent</div><div class="erp-kpi-value mt-1 text-amber-600">{{ absentCount }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">Total Staff</div><div class="erp-kpi-value mt-1">{{ staff | length }}</div></div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="erp-card erp-table-card">
    <div class="erp-card-header"><h3 class="font-semibold">Record Punch</h3></div>
    <form method="POST" action="/dashboard/biometric/punch" class="erp-card-body space-y-4">
      <div>
        <label class="erp-label">Staff</label>
        <select name="userId" class="erp-select">
          {% for s in staff %}<option value="{{ s.id }}" {% if user.id == s.id %}selected{% endif %}>{{ s.firstName }} {{ s.lastName }}</option>{% endfor %}
        </select>
      </div>
      <div>
        <label class="erp-label">Punch Type</label>
        <select name="punchType" class="erp-select">
          <option value="IN">Check In</option>
          <option value="OUT">Check Out</option>
        </select>
      </div>
      <div>
        <label class="erp-label">Device ID</label>
        <input type="text" name="deviceId" class="erp-input" placeholder="BIO-001">
      </div>
      <button type="submit" class="erp-btn-primary w-full">Record Punch</button>
    </form>
  </div>

  <div class="lg:col-span-2 erp-card">
    <div class="erp-card-header"><h3 class="font-semibold">Today's Log</h3></div>
      <div class="overflow-x-auto">
        <table class="erp-table">
      <thead><tr><th>Time</th><th>Staff</th><th>Branch</th><th>Type</th><th>Source</th></tr></thead>
      <tbody>
        {% for log in logs %}
        <tr>
          <td class="text-xs">{{ log.punchedAt | datetime }}</td>
          <td>{{ log.user.firstName }} {{ log.user.lastName }}</td>
          <td>{{ log.branch.name }}</td>
          <td><span class="erp-badge-neutral">{{ log.punchType }}</span></td>
          <td class="text-xs">{{ log.source }}</td>
        </tr>
        {% else %}
        <tr><td colspan="5" class="erp-empty-cell">No punches today</td></tr>
        {% endfor %}
      </tbody>
    </table>
</div>
</div>
{% endblock %}
