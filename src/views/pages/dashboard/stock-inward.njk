{% extends "layouts/main.njk" %}
{% from "partials/report-filters.njk" import reportPeriodFilter %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Stock Inward Dashboard') %}
{% endcall %}
{{ reportPeriodFilter('/dashboard/stock-inward', period) }}

<div class="erp-kpi-grid erp-kpi-grid-auto mb-6" style="grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));">
  <div class="erp-kpi"><div class="erp-kpi-label">Billable Inward (units)</div><div class="erp-kpi-value mt-1">{{ billableQty | number }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">Clinical Inward (units)</div><div class="erp-kpi-value mt-1">{{ clinicalQty | number }}</div></div>
  <div class="erp-kpi"><div class="erp-kpi-label">GRN Count</div><div class="erp-kpi-value mt-1">{{ grns | length }}</div></div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="erp-card erp-table-card">
    <div class="erp-card-header"><h3 class="font-semibold">GRN Receipts</h3></div>
      <div class="overflow-x-auto">
        <table class="erp-table text-sm">
      <thead><tr><th>GRN</th><th>PO</th><th>Status</th><th>Date</th></tr></thead>
      <tbody>
        {% for g in grns %}
        <tr>
          <td class="font-mono text-xs">{{ g.grnNo }}</td>
          <td class="font-mono text-xs">{{ g.po.poNo }}</td>
          <td>{{ statusBadge(g.status) }}</td>
          <td class="text-xs">{{ g.createdAt | date }}</td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="erp-empty-cell">No GRNs this period</td></tr>
        {% endfor %}
      </tbody>
    </table>
      </div></div>

  <div class="erp-card erp-table-card">
    <div class="erp-card-header"><h3 class="font-semibold">Stock Movements (GRN)</h3></div>
      <div class="overflow-x-auto">
        <table class="erp-table text-sm">
      <thead><tr><th>Product</th><th>Branch</th><th>Qty</th><th>Date</th></tr></thead>
      <tbody>
        {% for m in movements %}
        <tr>
          <td>{{ m.product.name }}</td>
          <td>{{ m.branch.name }}</td>
          <td class="font-medium text-emerald-600">+{{ m.quantity }}</td>
          <td class="text-xs">{{ m.createdAt | date }}</td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="erp-empty-cell">No inward movements</td></tr>
        {% endfor %}
      </tbody>
    </table>
</div>
</div>
{% endblock %}
