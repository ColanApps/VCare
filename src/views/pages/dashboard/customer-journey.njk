{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Customer Journey', journey.customer.uhid ~ ' · ' ~ journey.customer.phone) %}
  <a href="/customer/{{ journey.customer.id }}" class="erp-btn-secondary text-sm">Profile</a>
  <a href="/clinical/workflow/{{ journey.customer.id }}" class="erp-btn-secondary text-sm">Clinical Workflow</a>
  {% if journey.nextStep %}<a href="{{ journey.nextStep.url }}" class="erp-btn-primary text-sm">Continue: {{ journey.nextStep.label }}</a>{% endif %}
{% endcall %}

<div class="{% if journey.nextStep %}erp-triple-grid{% else %}grid grid-cols-1{% endif %} mb-8">
  <div class="{% if journey.nextStep %}lg:col-span-2{% endif %} erp-card">
    <div class="erp-card-header flex justify-between items-center">
      <h3 class="font-semibold text-slate-900">{{ journey.customer.name }}</h3>
      <span class="text-sm font-medium text-accent-600">{{ journey.progress }}%</span>
    </div>
    <div class="erp-card-body">
      <div class="erp-stat-bar h-2.5 mb-6">
        <div class="erp-stat-bar-fill" style="width: {% if journey.progress > 100 %}100{% else %}{{ journey.progress }}{% endif %}%"></div>
      </div>
      <ol class="space-y-2">
        {% for step in journey.steps %}
        <li class="flex items-center justify-between gap-4 rounded-xl px-4 py-3 border {% if step.done %}border-emerald-100 bg-emerald-50/50{% elif step.current %}border-amber-200 bg-amber-50{% else %}border-surface-border hover:bg-slate-50{% endif %}">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold shrink-0 {% if step.done %}bg-emerald-500 text-white{% elif step.current %}bg-amber-400 text-white{% else %}bg-slate-200 text-slate-600{% endif %}">
              {% if step.done %}✓{% else %}{{ loop.index }}{% endif %}
            </span>
            <span class="font-medium text-sm {% if step.done %}text-slate-600{% endif %}">{{ step.label }}</span>
          </div>
          {% if not step.done or step.current %}
          <a href="{{ step.url }}" class="erp-btn-secondary text-xs shrink-0">Go</a>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>

  {% if journey.nextStep %}
  <div class="erp-card border-accent-200 bg-gradient-to-br from-accent-50/80 to-white h-fit self-start">
    <div class="erp-card-body">
      <div>
        <p class="text-xs font-semibold text-accent-600 uppercase tracking-wider">Next step</p>
        <p class="text-xl font-semibold text-slate-900 mt-2">{{ journey.nextStep.label }}</p>
        <p class="text-sm text-slate-500 mt-2">Registration → Appointment → Consultation → Procedure → Billing → Payment</p>
      </div>
      <a href="{{ journey.nextStep.url }}" class="erp-btn-primary w-full justify-center mt-6">Continue</a>
      <a href="/clinical/workflow/{{ journey.customer.id }}" class="erp-btn-secondary w-full justify-center mt-2 text-center block">Open Clinical Workflow</a>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}
