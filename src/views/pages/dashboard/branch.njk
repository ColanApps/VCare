{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Branch Report') %}
{% endcall %}

<form method="GET" action="/dashboard/branch" class="erp-filter-bar mb-6">
  <div class="erp-field">
    <label class="erp-label">Month</label>
    <select name="month" class="erp-select">
      {% for m in range(1, 13) %}
      <option value="{{ m }}" {% if period.month == m %}selected{% endif %}>{{ ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][m-1] }}</option>
      {% endfor %}
    </select>
  </div>
  <div class="erp-field w-28">
    <label class="erp-label">Year</label>
    <input type="number" name="year" value="{{ period.year }}" class="erp-input">
  </div>
  <button type="submit" class="erp-btn-secondary">Filter</button>
</form>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  {% for branch in branches %}
  <div class="erp-card">
    <div class="erp-card-header">
      <div>
        <h3 class="font-semibold text-slate-900">{{ branch.name }}</h3>
        <span class="text-xs text-slate-500">{{ branch.code }} · {{ branch.type }}</span>
      </div>
      <span class="erp-badge-neutral">{{ branch.type }}</span>
    </div>
    <div class="erp-card-body">
      <div class="grid grid-cols-3 gap-3 mb-4">
        <div class="text-center p-2 bg-slate-50 rounded-lg">
          <div class="text-lg font-semibold text-slate-900">{{ branch._count.customers | number }}</div>
          <div class="text-[10px] text-slate-500 uppercase">Customers</div>
        </div>
        <div class="text-center p-2 bg-slate-50 rounded-lg">
          <div class="text-lg font-semibold text-slate-900">{{ branch._count.appointments | number }}</div>
          <div class="text-[10px] text-slate-500 uppercase">Appointments</div>
        </div>
        <div class="text-center p-2 bg-slate-50 rounded-lg">
          <div class="text-lg font-semibold text-slate-900">{{ branch._count.bills | number }}</div>
          <div class="text-[10px] text-slate-500 uppercase">Bills</div>
        </div>
      </div>
      {% if branch.monthTarget > 0 %}
      <div class="pt-3 border-t border-surface-border">
        <div class="flex justify-between text-xs mb-1.5">
          <span class="text-slate-500">Monthly Target</span>
          <span class="font-medium">{{ branch.monthTarget | currency }}</span>
        </div>
        <div class="flex justify-between text-xs mb-2">
          <span class="text-slate-500">Achieved</span>
          <span class="font-medium text-emerald-600">{{ branch.monthAchieved | currency }}</span>
        </div>
        <div class="erp-stat-bar h-2"><div class="erp-stat-bar-fill" style="width: {{ branch.monthProgress }}%"></div></div>
      </div>
      {% endif %}
      {% if branch.phone or branch.email %}
      <div class="mt-3 pt-3 border-t border-surface-border text-xs text-slate-500 space-y-1">
        {% if branch.phone %}<div>{{ branch.phone }}</div>{% endif %}
        {% if branch.email %}<div>{{ branch.email }}</div>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>
  {% else %}
  <div class="col-span-full text-center text-slate-400 py-12">No active branches found</div>
  {% endfor %}
</div>
{% endblock %}
