{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Delivery Challans') %}
{% endcall %}

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead><tr><th>Challan No</th><th>Order</th><th>Customer</th><th>Items</th><th>Status</th><th>Delivered</th><th>Date</th><th></th></tr></thead>
    <tbody>
      {% for c in challans %}
      <tr>
        <td class="font-mono text-xs font-medium">{{ c.challanNo }}</td>
        <td class="font-mono text-xs">{{ c.order.orderNo }}</td>
        <td>{{ c.order.customer.firstName }} {{ c.order.customer.lastName }}</td>
        <td>
          <ul class="text-xs space-y-0.5">
            {% for item in c.order.items %}<li>{{ item.product.name }} × {{ item.quantity }}</li>{% endfor %}
          </ul>
        </td>
        <td>{{ statusBadge(c.status) }}</td>
        <td class="text-xs">{% if c.deliveredAt %}{{ c.deliveredAt | datetime }}{% else %}—{% endif %}</td>
        <td class="text-xs text-slate-500">{{ c.createdAt | date }}</td>
        <td><a href="/sales/challans/{{ c.id }}/pdf" class="text-xs text-accent-600" target="_blank">PDF</a></td>
      </tr>
      {% else %}
        <tr><td colspan="8" class="erp-empty-cell">No delivery challans issued</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
