{% extends "layouts/main.njk" %}
{% from "macros/ui.njk" import pageToolbar, modalTrigger %}
{% block content %}
{% call pageToolbar('Geographical Master', 'Country → State → City → Area hierarchy') %}
  {{ modalTrigger('Add Country', '/registry/forms/geography/country', 'Add Country', 'md') }}
  {{ modalTrigger('Add State', '/registry/forms/geography/state', 'Add State', 'md') }}
  {{ modalTrigger('Add City', '/registry/forms/geography/city', 'Add City', 'md') }}
  {{ modalTrigger('Add Area', '/registry/forms/geography/area', 'Add Area', 'md') }}
{% endcall %}

<div class="space-y-4">
  {% for country in countries %}
  <div class="erp-card" x-data="{ open: true }">
    <button @click="open = !open" class="erp-card-header w-full text-left cursor-pointer hover:bg-slate-50">
      <div class="flex items-center gap-3">
        <svg class="w-4 h-4 transition-transform" :class="{ 'rotate-90': open }" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <h3 class="font-semibold text-slate-900">{{ country.name }}</h3>
        <span class="erp-badge-neutral text-xs">{{ country.code }}</span>
        <span class="text-xs text-slate-500">{{ country.states | length }} states</span>
      </div>
    </button>
    <div x-show="open" x-cloak class="erp-card-body border-t border-surface-border">
      {% for state in country.states %}
      <div class="mb-4 last:mb-0" x-data="{ stateOpen: false }">
        <button @click="stateOpen = !stateOpen" class="flex items-center gap-2 w-full text-left py-2 px-3 rounded-lg hover:bg-slate-50">
          <svg class="w-3 h-3 transition-transform" :class="{ 'rotate-90': stateOpen }" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="font-medium text-slate-800">{{ state.name }}</span>
          <span class="text-xs text-slate-400">{{ state.code }}</span>
          <span class="text-xs text-slate-500">· {{ state.cities | length }} cities</span>
        </button>
        <div x-show="stateOpen" x-cloak class="ml-6 mt-2 space-y-2">
          {% for city in state.cities %}
          <div class="p-3 bg-slate-50 rounded-lg">
            <div class="flex items-center justify-between">
              <span class="font-medium text-sm text-slate-700">{{ city.name }}</span>
              <span class="text-xs text-slate-400">{{ city.code }}</span>
            </div>
            {% if city.areas | length > 0 %}
            <div class="flex flex-wrap gap-1.5 mt-2">
              {% for area in city.areas %}
              <span class="text-[10px] px-2 py-0.5 bg-white border border-surface-border rounded-full text-slate-600">{{ area.name }}</span>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="erp-card"><div class="erp-card-body text-center text-slate-400 py-12">No geographical data — use forms above to add</div></div>
  {% endfor %}
</div>
{% endblock %}
