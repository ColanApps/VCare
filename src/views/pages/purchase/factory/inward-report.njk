{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Factory Inward Report') %}
{% endcall %}
<p class="text-sm text-slate-500 mb-4">{{ inwards | length }} accepted factory inwards</p>
<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead><tr><th>GRN No</th><th>PO</th><th>Indent</th><th>Branch</th><th>Vendor</th><th>Items</th><th>Accepted</th></tr></thead>
    <tbody>
      {% for g in inwards %}
      <tr>
        <td class="font-mono text-xs">{{ g.grnNo }}</td>
        <td>{{ g.po.poNo if g.po else '—' }}</td>
        <td>{{ g.factoryIndent.indentNo if g.factoryIndent else '—' }}</td>
        <td>{{ g.factoryIndent.branch.name if g.factoryIndent and g.factoryIndent.branch else '—' }}</td>
        <td>{{ g.po.vendor.name if g.po else '—' }}</td>
        <td>{{ g.items | length }}</td>
        <td class="text-xs">{{ g.updatedAt | date }}</td>
      </tr>
      {% else %}
      <tr><td colspan="7" class="erp-empty-cell">No accepted inwards</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
