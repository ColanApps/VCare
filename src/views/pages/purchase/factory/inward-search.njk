{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Factory Inward Search') %}
{% endcall %}
<form method="GET" class="erp-filter-bar mb-4">
  <input type="text" name="q" value="{{ filters.q or '' }}" class="erp-input flex-1" placeholder="GRN no, PO…">
  <select name="status" class="erp-select">
    <option value="">All</option>
    {% for s in ['QUALITY_CHECK','ACCEPTED','REJECTED'] %}<option value="{{ s }}" {% if filters.status == s %}selected{% endif %}>{{ s }}</option>{% endfor %}
  </select>
  <button type="submit" class="erp-btn-secondary">Search</button>
</form>
<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead><tr><th>GRN No</th><th>Indent</th><th>Branch</th><th>Vendor</th><th>Status</th><th>Date</th><th></th></tr></thead>
    <tbody>
      {% for g in inwards %}
      <tr>
        <td class="font-mono text-xs">{{ g.grnNo }}</td>
        <td>{{ g.factoryIndent.indentNo if g.factoryIndent else '—' }}</td>
        <td>{{ g.factoryIndent.branch.name if g.factoryIndent and g.factoryIndent.branch else '—' }}</td>
        <td>{{ g.po.vendor.name if g.po else '—' }}</td>
        <td>{{ statusBadge(g.status) }}</td>
        <td class="text-xs">{{ g.createdAt | date }}</td>
        <td>{% if g.status == 'QUALITY_CHECK' %}<a href="/purchase/factory/inward/{{ g.id }}/quality" class="text-xs text-blue-600">QC</a>{% endif %}</td>
      </tr>
      {% else %}
      <tr><td colspan="7" class="erp-empty-cell">No inwards found</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
