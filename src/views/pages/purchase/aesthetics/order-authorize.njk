{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Aesthetics PO Authorization') %}
{% endcall %}
<p class="text-sm text-slate-500 mb-6">{{ orders | length }} aesthetics POs pending authorization</p>
<div class="space-y-4">
  {% for o in orders %}
  <div class="erp-card">
    <div class="erp-card-header">
      <div>
        <h3 class="font-semibold">{{ o.poNo }}</h3>
        <span class="text-xs text-slate-500">{{ o.vendor.name }} · {{ o.branch.name if o.branch else '—' }}</span>
      </div>
      <div class="text-right">
        <div class="font-semibold text-lg">{{ o.totalAmount | currency }}</div>
        {{ statusBadge(o.status) }}
      </div>
    </div>
    <div class="erp-card-body">
      <div class="overflow-x-auto">
      <table class="erp-table mb-4 text-sm">
        <thead><tr><th>Product</th><th>Qty</th><th>Rate</th><th>Total</th></tr></thead>
        <tbody>
          {% for item in o.items %}
          <tr><td>{{ item.product.name }}</td><td>{{ item.quantity }}</td><td>{{ item.unitPrice | currency }}</td><td>{{ item.totalAmount | currency }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      <div class="flex gap-2">
        <form method="POST" action="/purchase/aesthetics/orders/{{ o.id }}/authorize" class="inline">
          <input type="hidden" name="action" value="approve">
          <button type="submit" class="erp-btn-primary text-sm">Approve</button>
        </form>
        <form method="POST" action="/purchase/aesthetics/orders/{{ o.id }}/authorize" class="inline">
          <input type="hidden" name="action" value="reject">
          <button type="submit" class="erp-btn-secondary text-sm text-red-600">Reject</button>
        </form>
      </div>
    </div>
  </div>
  {% else %}
  <div class="erp-card"><div class="erp-card-body text-center text-slate-400 py-12">No POs pending authorization</div></div>
  {% endfor %}
</div>
{% endblock %}
