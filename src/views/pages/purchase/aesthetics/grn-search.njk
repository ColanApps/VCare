{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('Aesthetics — GRN Search') %}
{% endcall %}
<form method="GET" class="erp-filter-bar mb-4">
  <div class="erp-field flex-1"><label class="erp-label">Search</label><input type="text" name="q" value="{{ filters.q or '' }}" class="erp-input"></div>
  <div class="erp-field"><label class="erp-label">Status</label>
    <select name="status" class="erp-select">
      <option value="">All</option>
      {% for s in ['DRAFT','QUALITY_CHECK','ACCEPTED','REJECTED'] %}
      <option value="{{ s }}" {% if filters.status == s %}selected{% endif %}>{{ s }}</option>
      {% endfor %}
    </select>
  </div>
  <button type="submit" class="erp-btn-secondary">Search</button>
</form>
<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead><tr><th>GRN No</th><th>PO</th><th>Vendor</th><th>Center</th><th>Status</th><th>Date</th><th></th></tr></thead>
    <tbody>
      {% for g in grns %}
      <tr>
        <td class="font-mono text-xs">{{ g.grnNo }}</td>
        <td>{{ g.po.poNo }}</td>
        <td>{{ g.po.vendor.name }}</td>
        <td>{{ g.po.branch.name if g.po.branch else '—' }}</td>
        <td>{{ statusBadge(g.status) }}</td>
        <td class="text-xs">{{ g.createdAt | date }}</td>
        <td>{% if g.status == 'QUALITY_CHECK' %}<a href="/purchase/aesthetics/grn/{{ g.id }}/quality" class="text-xs text-blue-600">QC</a>{% endif %}</td>
      </tr>
      {% else %}
      <tr><td colspan="7" class="erp-empty-cell">No GRNs found</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
