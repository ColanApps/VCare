{% extends "layouts/main.njk" %}
{% from "macros/components.njk" import statusBadge %}
{% from "macros/ui.njk" import pageToolbar %}
{% block content %}
{% call pageToolbar('GRN Search') %}
{% endcall %}

<form method="GET" class="erp-filter-bar mb-4">
  <div class="erp-field flex-1">
    <label class="erp-label">Search</label>
    <input type="text" name="q" value="{{ filters.q or '' }}" placeholder="GRN or PO number" class="erp-input">
  </div>
  <div class="erp-field">
    <label class="erp-label">Status</label>
    <select name="status" class="erp-select">
      <option value="">All statuses</option>
      {% for s in ['QUALITY_CHECK', 'ACCEPTED', 'REJECTED', 'PENDING'] %}
      <option value="{{ s }}" {% if filters.status == s %}selected{% endif %}>{{ s }}</option>
      {% endfor %}
    </select>
  </div>
  <button type="submit" class="erp-btn-secondary">Search</button>
</form>

<div class="erp-card erp-table-card">
  <div class="overflow-x-auto">
    <table class="erp-table">
    <thead><tr><th>GRN No</th><th>PO</th><th>Vendor</th><th>Status</th><th>Items</th><th>Date</th></tr></thead>
    <tbody>
      {% for g in grns %}
      <tr>
        <td class="font-mono text-xs font-medium">{{ g.grnNo }}</td>
        <td class="font-mono text-xs">{{ g.po.poNo }}</td>
        <td>{{ g.po.vendor.name }}</td>
        <td>{{ statusBadge(g.status) }}</td>
        <td class="text-xs">
          {% for item in g.items %}{{ item.product.name }} × {{ item.quantity }}{% if not loop.last %}, {% endif %}{% endfor %}
        </td>
        <td class="text-xs text-slate-500">{{ g.createdAt | date }}</td>
      </tr>
      {% else %}
      <tr><td colspan="6" class="erp-empty-cell">No GRNs found</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
