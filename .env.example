# VCare ERP Environment Configuration

NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-in-production

# Cloud deploy (Render/Railway): skip IP whitelist until you configure it in Admin
# IP_WHITELIST_ENFORCE=false

# MySQL (required) — local: docker compose up -d mysql
DATABASE_URL="mysql://vcare:vcare_secret@localhost:3306/vcare_erp"

# Sessions stored in the same MySQL database (table: express_sessions)
# SESSION_STORE=mysql
# SESSION_STORE=memory   # dev only — sessions lost on restart

UPLOAD_DIR=./uploads
VCARE_API_KEY=vcare-integration-key-2026

# Smoke test base URL (scripts/smoke-workflow.mjs)
# SMOKE_BASE_URL=http://localhost:3000

# ─── Render deployment ───────────────────────────────────────────────────────
# Set DATABASE_URL from your Render / external MySQL instance.
# Build:  npm run build
# Release: npm run db:push && npm run db:seed && npm run db:sync-permissions
# Start:   npm start
